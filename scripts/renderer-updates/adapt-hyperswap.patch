+class BufferForecast:
+    """Estimate one second of runway from recent foreground playback reports."""
+    def __init__(self):
+        self.sample = None
+        self.drain = 0.
+
+    def observe(self, seconds, now):
+        if seconds is None or not np.isfinite(seconds):
+            self.sample = None
+            self.drain = 0.
+            return None
+        if self.sample is None or not 0 <= now - self.sample[0] <= 2.5:
+            self.sample = (now, seconds)
+            self.drain = 0.
+        else:
+            elapsed = now - self.sample[0]
+            if elapsed >= .4:
+                loss = (self.sample[1] - seconds) / elapsed
+                self.drain = .5 * self.drain + .5 * max(0., min(1., loss))
+                self.sample = (now, seconds)
+        return max(0., seconds - self.drain)
+
